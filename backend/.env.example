APP_ENV=development
DATABASE_URL=postgresql://expense_user:replace-with-your-local-password@127.0.0.1:5432/expense_tracker_db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Development uses a single-process in-memory limiter. Production requires Redis.
RATELIMIT_STORAGE_URI=memory://
# Keep this key separate from encrypted backup files.
BACKUP_ENCRYPTION_KEY=
# Gmail: enter your full email address and a Google app password.
# SMTP_FROM defaults to SMTP_USERNAME. Never commit credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
