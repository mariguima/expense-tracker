APP_ENV=production
DATABASE_URL=postgresql://restricted_app_user:replace-me@private-database/expense_tracker_db?sslmode=verify-full
SECRET_KEY=replace-with-an-independent-random-secret
JWT_SECRET_KEY=replace-with-another-independent-random-secret
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
FRONTEND_URL=https://expenses.example.com
TRUSTED_HOSTS=expenses.example.com
RATELIMIT_STORAGE_URI=rediss://user:replace-me@private-redis:6379/0
# Keep at zero when Waitress handles forwarding using its trusted-proxy options.
# For another WSGI server, set this only for the exact number of trusted proxy hops.
TRUSTED_PROXY_COUNT=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=accounts@example.com
SMTP_USE_SSL=false
