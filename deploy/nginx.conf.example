# Install as a server configuration behind a firewall, replacing host and certificate paths.
# Serve frontend/dist at /srv/expense-tracker; run Waitress on loopback port 5000.
# Place log_format in nginx's http block. Exclude query strings (password-reset links).
log_format privacy '$remote_addr [$time_local] $request_method $uri $status $request_time';

server {
    listen 80;
    server_name expenses.example.com;
    return 301 https://expenses.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name expenses.example.com;
    ssl_certificate /etc/letsencrypt/live/expenses.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/expenses.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/expense-tracker;
    index index.html;
    client_max_body_size 32k;
    access_log /var/log/nginx/expenses-access.log privacy;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass http://127.0.0.1:5000/;
        proxy_set_header Host $host;
        # Replace untrusted client-supplied forwarding headers; this is one trusted hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
